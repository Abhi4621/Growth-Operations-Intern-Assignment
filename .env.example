# ==========================================
# GrowthOps Assessment - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_phrase_at_least_32_chars

# AI API Integration (Server-Side Only - Never exposed to client)
# Primary AI Provider: OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Fallback / Alternative AI Provider: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Optional Supabase Integration)
# If left empty, GrowthOps Assessment automatically uses persistent local file storage (server/data/db.json)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
